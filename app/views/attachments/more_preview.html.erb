<%- reloadpath = url_for(
      :controller    => "attachments",
      :action        => 'show',
      :id            => @attachment.id,
      :reload        => 1)
%>

<%= render :layout => 'layouts/file' do %>
  <div>
    <p class="contextual">
      <%# a reload converts again: only administrators may ask for it (see ControllerHelper#preview_reload?) %>
      <%= link_to l(:button_update), reloadpath, :class => "icon icon-reload" if User.current.admin? %>
      <%= call_hook(:preview_attachment_contextual, :attachment => @attachment, :project => @project ) %>
    </p>
  </div><div style="clear:both;"></div>
  <%- case @attachment.preview_format %>
  <%- when "inline" %>
    <div id="preview_repository_entry_top">
      <%= call_hook(:preview_attachment_top, :attachment => @attachment, :project => @project, :params => inline_preview_options ) %>
    </div>
    <div>
    <%= inline_more_preview( @attachment ) %>
    </div>
  <%- when "jpg", "jpeg", "png", "gif" %>
    <div id="preview_repository_entry_top">
      <%= call_hook(:preview_attachment_top, :attachment => @attachment, :project => @project, :params => preview_query_parameters.merge(:request => request).symbolize_keys ) %>
    </div>
    <div>
    <%= more_previews_image_tag(
          ::Setting['plugin_redmine_more_previews']['absolute'].to_i > 0 ?
          more_preview_url(
            @attachment, 
            @attachment.preview_format, 
            preview_query_parameters
          ) :
          more_preview_path(
            @attachment, 
            @attachment.preview_format, 
            preview_query_parameters
          ), 
          :alt => @attachment.filename,
          :style => "max-width:95%"
        ) %>
    </div>
  <%- else %>
    <script type="text/javascript">  
      $( document ).ready(function() {
        $('#preview_frame').on('load', function() {
          $('#ajax-indicator').hide();
        });
      });
    </script>
    <div id="preview_repository_entry_top">
      <%= call_hook(:preview_attachment_top, :attachment => @attachment, :project => @project, :params => preview_query_parameters.merge(:request => request).symbolize_keys ) %>
    </div>
    <div>
    <%= more_previews_tag(
          ::Setting['plugin_redmine_more_previews']['absolute'].to_i > 0 ?
          more_preview_url(
            @attachment, 
            @attachment.preview_format, 
            preview_query_parameters
          ) :
          more_preview_path(
            @attachment, 
            @attachment.preview_format, 
            preview_query_parameters
          ), 
          @attachment.filename,
         :type            => @attachment.preview_mime,
         :allow_downloads => RedmineMorePreviews::ControllerHelper.preview_allows_downloads?(@attachment.diskfile)
        ) %>
    </div>
  <% end %>
<%- end %>

