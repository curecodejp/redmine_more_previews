<%= call_hook(:view_repositories_show_contextual, { :repository => @repository, :project => @project }) %>

<div class="contextual">
  <%= render :partial => 'navigation' %>
</div>

<h2><%= render :partial => 'breadcrumbs', :locals => { :path => @path, :kind => 'file', :revision => @rev } %></h2>

<%= render :partial => 'link_to_functions' %>

<%- reloadpath = url_for(
      :controller    => "repositories",
      :action        => "entry",
      :id            => @project.identifier,
      :repository_id => @repository.identifier_param,
      :rev           => @rev,
      :path          => @path,
      :reload        => 1
      )
%>

<div>
  <p class="contextual">
    <%# a reload converts again: only administrators may ask for it (see ControllerHelper#preview_reload?) %>
    <%= link_to l(:button_update), reloadpath, :class => "icon icon-reload" if User.current.admin? %>
    <%= call_hook(:preview_repository_entry_contextual, :repository => @repository, :path => @path, :rev => @rev, :entry => @entry, :project => @project ) %>
  </p>
</div><div style="clear:both;"></div>

<%- case @repository.preview_format(@path, @rev) %>
  <%- when "inline" %>
    <div id="preview_repository_entry_top">
      <%= call_hook(:preview_repository_entry_top, :repository => @repository, :path => @path, :rev => @rev, :entry => @entry, :project => @project, :params => inline_preview_options ) %>
    </div>
    <div>
    <%= inline_more_preview( @repository, @path, @rev ) %>
    </div>
    
  <%- when "jpg", "jpeg", "png", "gif" %>
    <%= more_previews_image_tag(
          url_for({
                :controller    => "repositories",
                :action        => "more_preview",
                :id            => @project.identifier,
                :repository_id => @repository.identifier_param,
                :rev           => @rev,
                :path          => @path,
                :format        => @repository.preview_format(@path, @rev), 
                :only_path     => ::Setting['plugin_redmine_more_previews']['absolute'].to_i == 0
                }.merge(preview_query_parameters)
          ),
         :alt => @repository.preview_mime(@path, @rev),
         :style => "max-width:95%"
        ) %>
  <%- else %>
    <script type="text/javascript">
      $( document ).ready(function() {
        $('#preview_frame').on('load', function() {
          $('#ajax-indicator').hide();
        });
      });
    </script>
    <div id="preview_repository_entry_top">
      <%= call_hook(:preview_repository_entry_top, :repository => @repository, :path => @path, :rev => @rev, :entry => @entry, :project => @project, :params => preview_query_parameters.merge(:request => request).symbolize_keys ) %>
    </div>
    <div>
    <%= more_previews_tag(
           url_for({
                 :controller    => "repositories",
                 :action        => "more_preview",
                 :id            => @project.identifier,
                 :repository_id => @repository.identifier_param,
                 :rev           => @rev,
                 :path          => @path,
                 :format        => @repository.preview_format(@path, @rev), 
                 :only_path     => ::Setting['plugin_redmine_more_previews']['absolute'].to_i == 0
                 }.merge(preview_query_parameters)
           ),
           @entry.name,
          :type            => @repository.preview_mime(@path, @rev),
          :allow_downloads => @preview_allows_downloads
        ) %>
    </div>
<% end %>

<span class="pagination filepreview">
  <%= render_pagination %>
</span>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag "scm" %>
<% end %>



