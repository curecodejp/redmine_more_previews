<% if attachments.any? %>
  <% attachments.each do |key, val| %>
    <div style="display:inline-block;">
      <% if    object["type"] == :attachment %>
        <%= object["object"].try(:asset_link, val[:filename], true ) %>
        
      <% elsif object["type"] == :repository %>
        <%= object["object"].try(:asset_link, object["path"], object["rev"], val[:filename], true ) %>
        
      <% end %>
    </div>
  <% end %>
<% end %>
<% if omitted.to_i > 0 %>
  <div style="display:inline-block;"><%= I18n.translate(:"redmine_more_previews.cliff.text_more_attachments", :count => omitted.to_i) %></div>
<% end %>
