<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN" "http://www.w3.org/TR/html4/frameset.dtd">
<html>
  <head>
    <meta http-equiv="content-type" content="text/html; charset=utf-8">
    <style>
      /* pre-wrap, not pre-line: a plain-text mail relies on its spaces for
         indentation, signatures and quoted blocks, which pre-line collapses */
      .project_email_pre {
        white-space: pre-wrap;
        word-wrap: break-word;
      }
    </style>
  </head>
  <body>
    <%# Escape at the sink even when a caller has marked plain text as html_safe. %>
    <pre class='project_email_pre'><%= CGI.escapeHTML(@text.to_s) %></pre>
  </body>
</html>
