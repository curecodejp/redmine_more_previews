<%- converter = RedmineMorePreviews::Converter.responsible( entry.name, :pathonly => true ) %>
<%-if converter&.id == :cliff %>
  <%# emitted here, once, rather than inside headers.html / fields.html:
      those fragments pass the inline sanitiser (a <link> in them would live
      only while its path matched PLUGIN_STYLESHEET_HREF), there are three of
      them, and they are also served on their own as assets %>
  <%= tag(:link, :rel => "stylesheet", :media => "all",
          :href => "#{converter.public_web_directory}/stylesheets/redmine_more_previews_cliff.css") %>
  
  <% html_id = SecureRandom.uuid.to_s
    js = "$('##{html_id}-show, ##{html_id}-hide').toggle(); $('##{html_id}').fadeToggle(150);"
    toggler = ''.html_safe
    toggler << link_to_function("...", js, :id => "#{html_id}-show", :class => 'collapsible collapsed')
    toggler << link_to_function(" x", js, :id => "#{html_id}-hide", :class => 'collapsible', :style => 'display:none;')
  %>
  
  <%# Fetch the generated header fragments from the same persistent cache as
      the email body. A block argument to more_asset forces a full temporary
      conversion even when the preview is already cached. %>
  <% names = %w(headers.html fields.html attachments.html)
     if RedmineMorePreviews::Converter.cache_previews? &&
        (!RedmineMorePreviews::Lib::RmpCacheSize.full? || repository.preview_available?(path, rev))
       # Read the cached fragments directly; a missing preview is generated by
       # the first asset request without reading its entire index.html.
       fragments = names.map { |name| repository.more_asset(path, rev, :asset => name) }
     else
       # With caching disabled or full, convert once and render the fragments
       # immediately instead of attempting three more uncached conversions.
       fragments = repository.more_asset(path, rev, :assets => names) { |_html, _asset, *data| data }
     end
     email_headers, email_fields, email_attachments = fragments || []
  %>
  
    <% if email_headers %>
      <div class="box"><%= sanitize_inline_preview( RedmineMorePreviews::Lib::RmpText.to_utf8(email_headers) ) %></div>
    <%- end %>
    
    <% if email_fields %>
      <%= toggler.html_safe %>
      <div class="box" id="<%= html_id %>" style="display:none;"><%= sanitize_inline_preview( RedmineMorePreviews::Lib::RmpText.to_utf8(email_fields) ) %></div>
    <%- end %>
    
    <% if email_attachments %>
      <div class="box"><%= sanitize_inline_preview( RedmineMorePreviews::Lib::RmpText.to_utf8(email_attachments) ) %></div>
    <%- end %>
    
<% end %>
