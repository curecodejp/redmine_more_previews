<h2>Converter debug information</h2>
<p>Only non-sensitive converter metadata is shown. Internal paths, request data, settings, and objects are omitted.</p>
<table>
  <tbody>
    <% details.each do |key, value| %>
      <tr>
        <td><%= CGI.escapeHTML(key) %></td>
        <td><%= CGI.escapeHTML(value) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
